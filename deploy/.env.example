# Copy to .env next to docker-compose.yml. Never commit the filled-in file.
# The domain must already point at this server (an A record), or HTTPS cannot be issued.
TREK_DOMAIN=trek.example.ch
# Generate with: openssl rand -hex 32. Back it up: without it stored secrets cannot be decrypted.
ENCRYPTION_KEY=
# The first admin account, created on the very first start only.
ADMIN_EMAIL=you@example.ch
ADMIN_PASSWORD=
TZ=Europe/Zurich
